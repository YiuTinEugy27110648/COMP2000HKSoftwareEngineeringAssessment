<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".managermybookingselectroom">


    <ImageView
        android:id="@+id/iv_login_page2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/managermybookingselectroomclean"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ScrollView
        android:id="@+id/scroll_select_room"
        android:layout_width="wrap_content"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="0.6834"
        app:layout_constraintHorizontal_bias="0.27"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.60">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <ImageButton
                android:id="@+id/btn_selectroom_a"
                android:layout_width="338dp"
                android:layout_height="125dp"
                android:layout_marginBottom="13dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/bookingroom_selectroom_a" />

            <ImageButton
                android:id="@+id/btn_selectroom_b"
                android:layout_width="338dp"
                android:layout_height="125dp"
                android:layout_marginBottom="16dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/bookingroom_selectroom_b" />

            <ImageButton
                android:id="@+id/btn_selectroom_c"
                android:layout_width="338dp"
                android:layout_height="125dp"
                android:layout_marginBottom="16dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/bookingroom_selectroom_c" />

            <ImageButton
                android:id="@+id/btn_selectroom_d"
                android:layout_width="338dp"
                android:layout_height="125dp"
                android:layout_marginBottom="16dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/bookingroom_selectroom_d_a" />

            <ImageButton
                android:id="@+id/btn_selectroom_e"
                android:layout_width="338dp"
                android:layout_height="125dp"
                android:layout_marginBottom="16dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/bookingroom_selectroom_e" />

            <ImageButton
                android:id="@+id/btn_selectroom_f"
                android:layout_width="338dp"
                android:layout_height="125dp"
                android:layout_marginBottom="16dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/bookingroom_selectroom_f" />

            <ImageButton
                android:id="@+id/btn_selectroom_g"
                android:layout_width="338dp"
                android:layout_height="125dp"
                android:layout_marginBottom="16dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/bookingroom_selectroom_g" />

            <ImageButton
                android:id="@+id/btn_selectroom_h"
                android:layout_width="338dp"
                android:layout_height="125dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/bookingroom_selectroom_h" />

        </LinearLayout>
    </ScrollView>

    <ImageButton
        android:id="@+id/btn_managermenuhomebutton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.071"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.97"
        app:layout_constraintWidth_percent="0.15 " />
    <ImageButton
        android:id="@+id/btn_managermenubutton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.369"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.969"
        app:layout_constraintWidth_percent="0.15" />

    <ImageButton
        android:id="@+id/btn_managermybookingbutton"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.644"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.969"
        app:layout_constraintWidth_percent="0.15" />

    <ImageButton
        android:id="@+id/btn_managermyprofile"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.957"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.969"
        app:layout_constraintWidth_percent="0.15" />


</androidx.constraintlayout.widget.ConstraintLayout>