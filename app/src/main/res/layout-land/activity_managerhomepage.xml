<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".managerhomepage">

    <ImageView
        android:id="@+id/iv_login_page_horizontal"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/layouthorizontalsecond"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <ImageView
        android:id="@+id/iv_login_page"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:src="@drawable/managerhomepagethird"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <HorizontalScrollView
        android:id="@+id/scroll_upcoming_booking"
        android:layout_width="0dp"
        android:layout_marginStart="360dp"
        android:layout_marginEnd="350dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.275">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="0dp"
            android:paddingEnd="0dp">

            <ImageButton
                android:id="@+id/btn_upcoming_first"
                android:layout_width="90dp"
                android:layout_height="115dp"
                android:layout_marginEnd="2dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/manager_upcoming_booking_first" />

            <ImageButton
                android:id="@+id/btn_upcoming_second"
                android:layout_width="90dp"
                android:layout_height="115dp"
                android:layout_marginEnd="2dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/manager_upcoming_booking_second" />

            <ImageButton
                android:id="@+id/btn_upcoming_third"
                android:layout_width="90dp"
                android:layout_height="115dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/manager_upcoming_booking_third" />

        </LinearLayout>
    </HorizontalScrollView>

    <HorizontalScrollView
        android:id="@+id/scroll_room_states"
        android:layout_width="0dp"
        android:layout_marginStart="350dp"
        android:layout_marginEnd="350dp"
        android:layout_height="wrap_content"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.72">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="71dp"
            android:paddingEnd="24dp">

            <ImageButton
                android:id="@+id/btn_roomstates_a"
                android:layout_width="75dp"
                android:layout_height="120dp"
                android:layout_marginEnd="10dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/manager_roomstates_a" />

            <ImageButton
                android:id="@+id/btn_roomstates_b"
                android:layout_width="75dp"
                android:layout_height="120dp"
                android:layout_marginEnd="10dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/manager_roomstates_b" />

            <ImageButton
                android:id="@+id/btn_roomstates_c"
                android:layout_width="75dp"
                android:layout_height="120dp"
                android:layout_marginEnd="10dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/manager_roomstates_c" />

            <ImageButton
                android:id="@+id/btn_roomstates_d"
                android:layout_width="75dp"
                android:layout_height="120dp"
                android:layout_marginEnd="10dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/manager_roomstates_d" />

            <ImageButton
                android:id="@+id/btn_roomstates_e"
                android:layout_width="75dp"
                android:layout_height="120dp"
                android:layout_marginEnd="10dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/manager_roomstates_e" />

            <ImageButton
                android:id="@+id/btn_roomstates_f"
                android:layout_width="75dp"
                android:layout_height="120dp"
                android:layout_marginEnd="10dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/manager_roomstates_f" />

            <ImageButton
                android:id="@+id/btn_roomstates_g"
                android:layout_width="75dp"
                android:layout_height="120dp"
                android:layout_marginEnd="10dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/manager_roomstates_g" />

            <ImageButton
                android:id="@+id/btn_roomstates_h"
                android:layout_width="75dp"
                android:layout_height="120dp"
                android:background="@android:color/transparent"
                android:scaleType="fitCenter"
                android:src="@drawable/manager_roomstates_h" />


        </LinearLayout>
    </HorizontalScrollView>

    <ImageButton
        android:id="@+id/btn_managernewbooking"
        android:layout_width="111dp"
        android:layout_height="46dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.424"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.472" />

    <ImageButton
        android:id="@+id/btn_manager_cancel_booking"
        android:layout_width="119dp"
        android:layout_height="47dp"
        android:layout_marginTop="260dp"
        android:background="@android:color/transparent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.576"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        android:id="@+id/btn_managermenuhomebutton"
        android:layout_width="40dp"
        android:layout_height="29dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.39"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.98"
        app:layout_constraintWidth_percent="0.15 " />

    <ImageButton
        android:id="@+id/btn_managermenubutton"
        android:layout_width="40dp"
        android:layout_height="33dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.466"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.98"
        app:layout_constraintWidth_percent="0.15" />

    <ImageButton
        android:id="@+id/btn_managermybookingbutton"
        android:layout_width="46dp"
        android:layout_height="33dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.54"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.98"
        app:layout_constraintWidth_percent="0.15" />

    <ImageButton
        android:id="@+id/btn_managermyprofile"
        android:layout_width="46dp"
        android:layout_height="33dp"
        android:background="@android:color/transparent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="2:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.61"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.98"
        app:layout_constraintWidth_percent="0.15" />



</androidx.constraintlayout.widget.ConstraintLayout>
